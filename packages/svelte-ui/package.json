{
  "name": "@kozou/svelte-ui",
  "version": "1.21.1",
  "description": "Kozou reference Admin UI. SvelteKit + Svelte 5 admin UI that consumes SchemaContext via @kozou/core and talks to a backend via the DataAdapter interface.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kozou-dev/kozou.git",
    "directory": "packages/svelte-ui"
  },
  "homepage": "https://kozou.org",
  "bugs": {
    "url": "https://github.com/kozou-dev/kozou/issues"
  },
  "type": "module",
  "main": "./build/handler.js",
  "exports": {
    ".": {
      "import": "./build/index.js"
    },
    "./handler": {
      "import": "./build/handler.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepublishOnly": "pnpm run build",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test --config playwright.kozou-api.config.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@kozou/core": "workspace:*",
    "@kozou/introspect": "workspace:*",
    "@kozou/ui-core": "workspace:*",
    "@lucide/svelte": "^1.70.0",
    "@tanstack/table-core": "^9.3.1",
    "bits-ui": "^2.20.6",
    "clsx": "^2.1.1",
    "formsnap": "^2.1.0",
    "sveltekit-superforms": "^2.30.2",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kozou/api": "workspace:*",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/pg": "^8.23.1",
    "jsdom": "^25.0.0",
    "pg": "^8.23.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "testcontainers": "^12.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  }
}
