{
  "name": "@kozou/svelte-ui",
  "version": "1.2.0",
  "description": "Kozou reference Admin UI. SvelteKit + Svelte 5 admin UI that consumes SchemaContext via @kozou/core and talks to a backend via the DataAdapter interface.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kozou-dev/kozou.git",
    "directory": "packages/svelte-ui"
  },
  "homepage": "https://kozou.org",
  "bugs": {
    "url": "https://github.com/kozou-dev/kozou/issues"
  },
  "type": "module",
  "main": "./build/handler.js",
  "exports": {
    ".": {
      "import": "./build/index.js"
    },
    "./handler": {
      "import": "./build/handler.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepublishOnly": "pnpm run build",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test --config playwright.kozou-api.config.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.1",
    "@kozou/core": "workspace:*",
    "@kozou/introspect": "workspace:*",
    "@lucide/svelte": "^1.16.0",
    "@tanstack/table-core": "^8.21.3",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "formsnap": "^2.0.1",
    "sveltekit-superforms": "^2.30.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@kozou/api": "workspace:*",
    "@playwright/test": "^1.50.0",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@testcontainers/postgresql": "^12.0.2",
    "@testing-library/svelte": "^5.2.0",
    "@types/pg": "^8.11.10",
    "jsdom": "^25.0.0",
    "pg": "^8.13.0",
    "svelte": "^5.55.9",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^4.3.0",
    "testcontainers": "^12.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
}
