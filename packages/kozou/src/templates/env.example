# Copy this file to .env, then `docker compose up`. The defaults below bring
# up a loopback-only local dev stack out of the box. Change the credentials
# before exposing the database beyond this machine.

POSTGRES_USER=kozou
POSTGRES_PASSWORD=kozou
POSTGRES_DB=kozou
POSTGRES_PORT=5432

# DATABASE_URL is intentionally not set here. docker-compose.yml builds it from
# the POSTGRES_* parts above (postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}
# @postgres:5432/${POSTGRES_DB}), so editing those values can't desync a
# duplicated connection string. Set DATABASE_URL only when running kozou
# outside this compose stack.

# Only for the PostgREST opt-out (adapter.type: postgrest). The default
# in-house REST backend serves in-process and ignores this.
# KOZOU_ADAPTER_URL=http://postgrest:3000

# Public URL you open the Admin UI on. The bundled SvelteKit
# (adapter-node) server needs this to accept form submissions over plain
# http — without it, create / edit / delete are rejected with a 403
# "Cross-site POST forbidden". Override if you serve the UI elsewhere.
KOZOU_ORIGIN=http://localhost:3333

# Serve the MCP Streamable HTTP endpoint at all? Unset keeps it on (the
# default) — it is what an AI client connects to. Set false to run this stack
# as Admin UI + REST only: no MCP listener starts, `kozou mcp --http` refuses,
# and the Admin UI drops its "Connect an AI agent" page. Without a
# server.mcp.http.auth block the endpoint has no authentication of its own, so
# if no agent will ever connect, not running it beats keeping it on loopback.
# Must read as true or false (case and surrounding whitespace are ignored);
# any other value is refused at startup rather than guessed at.
# KOZOU_MCP_HTTP_ENABLED=false

# Where MCP clients reach the endpoint, when that is not the published port.
# This stack binds 3334 in the container; anything in between — a remapped host
# port in docker-compose.yml, a tunnel, a devcontainer, a reverse proxy that
# forwards /mcp unchanged — makes that a different address from the one clients
# must use, and the Admin UI's "Connect an AI agent" page cannot see the
# difference. Unset, it advertises the bind port; set, it advertises exactly
# this, verbatim. Set it whenever you move the published port.
# Must be an absolute http(s) URL with no query or fragment, whose path is
# exactly /mcp — the transport serves that path and no other, so a bare host, a
# trailing slash (/mcp/) and a sub-path (/api/mcp) are all refused. The scheme
# (http or https), host and port are yours to change; the path is not, so an
# endpoint reached under a path prefix cannot be advertised here.
# Refused at startup in two combinations, so uncomment only one of each pair:
#   - with KOZOU_MCP_HTTP_ENABLED=false above (nothing is served, so there is
#     no address to advertise)
#   - with a server.mcp.http.auth block (auth.resource already declares the
#     address there, and it is the one clients discover from the endpoint)
# KOZOU_MCP_HTTP_ADVERTISED_URL=http://localhost:4334/mcp

# JWT auth for the in-house API backend (the default `kozou dev`).
# Leave unset to keep it unauthenticated and loopback-only (the default).
# KOZOU_JWT_SECRET=your-hs256-secret   # HS256 — or KOZOU_JWT_PUBLIC_KEY / KOZOU_JWT_JWKS_URI
# KOZOU_JWT_JWKS_URI=https://your-idp/.well-known/jwks.json  # Auth0 / Clerk / Supabase
# KOZOU_JWT_ANON_ROLE=web_anon         # role for requests with no token (else 401)
# KOZOU_UI_ROLE=app_admin              # role the bundled Admin UI runs as (HS256)
# KOZOU_UI_CLAIMS={"tenant_id":"acme"} # extra claims minted into the UI token (HS256, JSON object)
# KOZOU_ADAPTER_TOKEN=                 # RS256 / external IdP: a ready-made UI token
