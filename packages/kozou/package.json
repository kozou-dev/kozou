{
  "name": "kozou",
  "version": "1.12.4",
  "description": "Kozou CLI: scaffolding, schema introspection, and MCP server entry points.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kozou-dev/kozou.git",
    "directory": "packages/kozou"
  },
  "homepage": "https://kozou.org",
  "bugs": {
    "url": "https://github.com/kozou-dev/kozou/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "kozou": "./dist/cli.js",
    "create-kozou": "./dist/create-kozou.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/copy-templates.mjs",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test --config playwright.kozou-api.config.ts",
    "test:e2e:api:auth": "playwright test --config playwright.kozou-api-auth.config.ts"
  },
  "dependencies": {
    "@kozou/api": "workspace:*",
    "@kozou/core": "workspace:*",
    "@kozou/introspect": "workspace:*",
    "@kozou/mcp": "workspace:*",
    "@kozou/svelte-ui": "workspace:*",
    "commander": "^14.0.0",
    "pg": "^8.13.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@kozou/codegen": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@playwright/test": "^1.50.0",
    "@testcontainers/postgresql": "^12.0.0",
    "@types/pg": "^8.11.10",
    "testcontainers": "^12.0.4",
    "tsx": "^4.19.0"
  }
}
