    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@kozou/core": "workspace:*",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@kozou/test-utils": "workspace:*",
    "@types/pg": "^8.11.0"
