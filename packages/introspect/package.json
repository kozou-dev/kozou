{
  "name": "@kozou/introspect",
  "version": "1.10.0",
  "description": "PostgreSQL DDL / COMMENT / VIEW introspection.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kozou-dev/kozou.git",
    "directory": "packages/introspect"
  },
  "homepage": "https://kozou.org",
  "bugs": {
    "url": "https://github.com/kozou-dev/kozou/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
