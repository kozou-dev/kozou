{
  "name": "@kozou/core",
  "version": "1.13.0",
  "description": "Kozou core: Schema Context, type definitions, UI Hints zod schema, DataAdapter interface.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kozou-dev/kozou.git",
    "directory": "packages/core"
  },
  "homepage": "https://kozou.org",
  "bugs": {
    "url": "https://github.com/kozou-dev/kozou/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./auth": {
      "import": "./dist/auth.js",
      "types": "./dist/auth.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.test.json",
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "jose": "^6.2.3",
    "yaml": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "pg": "^8.13.0"
  }
}
