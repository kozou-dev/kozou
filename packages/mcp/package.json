{
  "name": "@kozou/mcp",
  "version": "1.16.0",
  "description": "Kozou MCP server for AI agents (stdio + HTTP)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kozou-dev/kozou.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://kozou.org",
  "bugs": {
    "url": "https://github.com/kozou-dev/kozou/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "kozou-mcp": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.test.json",
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@kozou/core": "workspace:*",
    "@kozou/introspect": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "pg": "^8.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@kozou/test-utils": "workspace:*",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0"
  }
}
