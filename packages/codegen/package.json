{
  "name": "@kozou/codegen",
  "version": "1.4.1",
  "description": "Kozou TypeScript codegen: emit row / entity types from a SchemaContext (experimental).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kozou-dev/kozou.git",
    "directory": "packages/codegen"
  },
  "homepage": "https://kozou.org",
  "bugs": {
    "url": "https://github.com/kozou-dev/kozou/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.test.json",
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@kozou/core": "workspace:*"
  },
  "devDependencies": {
    "@kozou/introspect": "workspace:*",
    "typescript": "^6.0.3"
  }
}
