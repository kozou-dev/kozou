# Copy to .env before `docker compose up`. The defaults work out of the box;
# this is a local demo, so the credentials are intentionally trivial.

POSTGRES_USER=kozou
POSTGRES_PASSWORD=kozou
POSTGRES_DB=kozou
POSTGRES_PORT=5432

# Public URL you open the Admin UI on (needed for form submissions over http).
KOZOU_ORIGIN=http://localhost:3333
