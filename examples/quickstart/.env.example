# Copy to .env before `docker compose up`. The defaults work out of the box;
# this is a local demo, so the credentials are intentionally trivial.

POSTGRES_USER=kozou
POSTGRES_PASSWORD=kozou
POSTGRES_DB=kozou
POSTGRES_PORT=5432

# Public URL you open the Admin UI on (needed for form submissions over http).
KOZOU_ORIGIN=http://localhost:3333

# Serve the MCP Streamable HTTP endpoint at all? Unset keeps it on (the
# default) — it is what an AI client connects to. Set false to run this stack
# as Admin UI + REST only: no MCP listener starts and the Admin UI drops its
# "Connect an AI agent" page. The published port stays mapped either way, so
# 3334 is still taken on this host. Must read as true or false; any other
# value is refused at startup rather than guessed at.
# KOZOU_MCP_HTTP_ENABLED=false

# Where MCP clients reach the endpoint, when that is not the published port.
# Remap the MCP port mapping in docker-compose.yml (a clash with something
# already on 3334), or front it with a tunnel or a proxy that forwards /mcp
# unchanged, and the "Connect an AI agent" page cannot see it — unset, it
# advertises the container-side port.
# Must be an absolute http(s) URL with no query or fragment, whose path is
# exactly /mcp: a trailing slash (/mcp/) and a sub-path (/api/mcp) are refused,
# so an endpoint reached under a path prefix cannot be advertised here.
# Refused at startup together with KOZOU_MCP_HTTP_ENABLED=false above.
# KOZOU_MCP_HTTP_ADVERTISED_URL=http://localhost:4334/mcp

# Hostnames the DNS-rebinding guard should also accept (comma-separated). The
# guard already derives the loopback names, a specific bind host, and the
# hostname above; this is for what it cannot derive — a second valid external
# path, or an internal name that also reaches the endpoint. Bare hostnames,
# optionally with a port; a URL or a path is refused at startup.
# KOZOU_MCP_HTTP_ALLOWED_HOSTS=mcp.internal,tunnel.example.com
