{
  "mcpServers": {
    "kozou-without": {
      "command": "pnpm",
      "args": ["--filter", "@kozou/mcp", "exec", "tsx", "src/cli.ts"],
      "env": {
        "KOZOU_DATABASE_URL": "postgres://postgres:demo@localhost:5500/postgres"
      }
    },
    "kozou-with": {
      "command": "pnpm",
      "args": ["--filter", "@kozou/mcp", "exec", "tsx", "src/cli.ts"],
      "env": {
        "KOZOU_DATABASE_URL": "postgres://postgres:demo@localhost:5501/postgres"
      }
    }
  }
}
